        <div class="stat-card">
          <i class="fa-solid fa-wand-magic-sparkles"></i>
          <div class="stat-number">100%</div>
          <div class="stat-label">Custom Transitions</div>
        </div>
        <div class="stat-card">
          <i class="fa-solid fa-gauge-high"></i>
          <div class="stat-number">24h</div>
          <div class="stat-label">Fast Turnaround</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM SECTION -->
  <section id="contact">
    <div class="section-header">
      <h2 class="section-title">Let's Connect</h2>
      <p class="section-desc">Have a project, sponsorship, or edit inquiry? Drop a message.</p>
    </div>

    <div class="contact-card">
      <form id="contact-form">
        <div class="form-group">
          <label for="name">Your Name</label>
          <input type="text" id="name" class="form-control" placeholder="e.g. Alex Drake" required />
        </div>
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" class="form-control" placeholder="alex@domain.com" required />
        </div>
        <div class="form-group">
          <label for="message">Project Details</label>
          <textarea id="message" class="form-control" placeholder="Describe the edit style, timeline, or sponsorship proposal..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
          <i class="fa-solid fa-paper-plane"></i> Send Inquiry
        </button>
        <div class="form-msg" id="form-feedback">
          Thank you! Your message has been sent successfully.
        </div>
      </form>
    </div>
  </section>

