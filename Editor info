  </section>

  <!-- ABOUT & STATS SECTION -->
  <section id="about">
    <div class="section-header">
      <h2 class="section-title">Channel Insights</h2>
      <p class="section-desc">Behind the timeline and cutting-edge creative vision</p>
    </div>

    <div class="about-container">
      <div class="about-text">
        <h3>Crafting Visual Identity</h3>
        <p>
          <strong>Edited By Ahsn</strong> specializes in dynamic pacing, precision color grading, motion graphics, and immersive audio design.
        </p>
        <p>
          Whether crafting high-intensity YouTube shorts, tech breakdowns, or cinematic highlight reels, each project is optimized for maximum viewer retention and aesthetic impact.
        </p>
        <a href="#contact" class="btn btn-secondary">
          <i class="fa-solid fa-envelope"></i> Request Collaboration
        </a>
      </div>

      <div class="stats-grid">
        <div class="stat-card">
          <i class="fa-solid fa-video"></i>
          <div class="stat-number">4K 60</div>
          <div class="stat-label">Ultra HD Render</div>
        </div>
        <div class="stat-card">
          <i class="fa-solid fa-users"></i>
          <div class="stat-number">Fast Growing</div>
          <div class="stat-label">Active Audience</div>
